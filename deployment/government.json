{
  "profile": "government",
  "tier": "FIPS-Compliant Sovereign Cloud",
  "features": {
    "tenantIsolation": "separated-schema-by-tenant",
    "replayVerification": "cryptographic-block-hashing",
    "embeddingProvider": "fedramp-compliant-endpoint",
    "cacheStrategy": "fips-encrypted-in-transit-redis",
    "auditStorage": "worm-append-only-hardware"
  },
  "limits": {
    "maxDocumentsPerProject": 50000,
    "maxFileSizeMb": 500,
    "concurrentReplays": 32,
    "vectorTtlDays": -1
  },
  "redundancy": {
    "databaseReplication": true,
    "aiProviderFallback": true,
    "fallbackChain": ["sovereign-endpoint-a", "sovereign-endpoint-b"]
  }
}
