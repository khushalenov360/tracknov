{
  "profile": "startup",
  "tier": "Standard SaaS",
  "features": {
    "tenantIsolation": "logical",
    "replayVerification": "periodic",
    "embeddingProvider": "gemini-api",
    "cacheStrategy": "in-memory",
    "auditStorage": "postgresql-logs"
  },
  "limits": {
    "maxDocumentsPerProject": 100,
    "maxFileSizeMb": 10,
    "concurrentReplays": 1,
    "vectorTtlDays": 30
  },
  "redundancy": {
    "databaseReplication": false,
    "aiProviderFallback": true
  }
}
