{
  "profile": "multi-region",
  "tier": "Global Resilient Edge Network",
  "features": {
    "tenantIsolation": "geo-fenced-schema-residency",
    "replayVerification": "distributed-consensus-hashing",
    "embeddingProvider": "region-localized-gemini",
    "cacheStrategy": "distributed-upstash-redis",
    "auditStorage": "replicated-event-streams"
  },
  "limits": {
    "maxDocumentsPerProject": 10000,
    "maxFileSizeMb": 100,
    "concurrentReplays": 64,
    "vectorTtlDays": 180
  },
  "redundancy": {
    "databaseReplication": true,
    "aiProviderFallback": true,
    "anycastRouting": true
  }
}
