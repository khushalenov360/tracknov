{
  "name": "tracknov-studio",
  "version": "0.1.0",
  "description": "Tracknov launcher for IGBC consultants and project teams.",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khushalenov360/tracknov.git"
  },
  "bugs": {
    "url": "https://github.com/khushalenov360/tracknov/issues"
  },
  "homepage": "https://github.com/khushalenov360/tracknov#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "tracknov",
    "igbc-documentation",
    "igbc",
    "consulting",
    "nextjs",
    "cli"
  ],
  "bin": {
    "tracknov": "./bin/tracknov.mjs"
  },
  "files": [
    "bin",
    "app",
    "components",
    "data",
    "lib",
    "public",
    "scripts",
    "supabase/migrations",
    "tests",
    "README.md",
    "LICENSE",
    ".env.example",
    ".eslintrc.json",
    "components.json",
    "middleware.ts",
    "next.config.mjs",
    "package.json",
    "playwright.config.ts",
    "postcss.config.mjs",
    "tailwind.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "clean:cache": "node scripts/clean-next-cache.mjs",
    "dev": "next dev",
    "dev:guided": "bun run scripts/dev-guided.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prepublishOnly": "npm run lint",
    "publish:public": "npm publish --access public",
    "seed": "node scripts/seed.mjs",
    "onboard": "node bin/tracknov.mjs",
    "smoke": "playwright test",
    "qa:ux": "playwright test tests/ux-quality-gates.spec.ts",
    "qa:rbac": "playwright test tests/rbac-matrix.spec.ts",
    "qa:exports": "playwright test tests/export-structure.spec.ts",
    "qa:events": "playwright test tests/event-bus.spec.ts",
    "qa:workflow": "playwright test tests/workflow-state-machine.spec.ts",
    "qa:runtime-audit": "node scripts/runtime-audit-automation.mjs",
    "qa:governance-check": "npx tsx scripts/check-governance.ts",
    "smoke:headed": "playwright test --headed"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "@types/pdf-parse": "^1.1.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "glob": "^13.0.6",
    "headroom-ai": "^0.22.4",
    "hyperformula": "^3.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "next": "^16.3.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.5.0",
    "chai": "^6.2.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.0",
    "mocha": "^11.7.6",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
